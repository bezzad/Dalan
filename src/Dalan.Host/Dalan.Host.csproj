<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../Identity/Dalan.Identity/Dalan.Identity.csproj" />
    <ProjectReference Include="../Relay/Dalan.Relay/Dalan.Relay.csproj" />
    <ProjectReference Include="../Notification/Dalan.Notification/Dalan.Notification.csproj" />
    <ProjectReference Include="../Admin/Dalan.Admin/Dalan.Admin.csproj" />
    <ProjectReference Include="../Plugins/Dalan.Telegram/Dalan.Telegram.csproj" />
  </ItemGroup>
  <!-- CLI-02: the built PWA is inside the binary, so the release stays one file. -->
  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <EmbeddedResource Include="../../client/dist/**" LinkBase="wwwroot" />
  </ItemGroup>
  <Target Name="CheckClientIsBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../../client/dist/index.html')"
           Text="The client is not built. Run: (cd client &amp;&amp; npm ci &amp;&amp; npm run build)" />
  </Target>
  <!-- Only for "dotnet ef migrations add" on a developer machine; it must not ship in the release. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <!-- Local settings stay out of the release (DEL-03: the release is the binary and appsettings.json). -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
