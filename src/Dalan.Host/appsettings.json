{
  "Dalan": {
    "Version": "dev",
    "ShutdownTimeoutSeconds": 30,
    "StartupRetrySeconds": 5,
    "IpRequestLimit": 100,
    "IpLimitWindowSeconds": 1,
    "TrustedProxies": "127.0.0.1,::1"
  },
  "Admin": {
    "AccessLogIntervalMinutes": 60,
    "AccessLogRetentionDays": 180,
    "AccessLogSweepMinutes": 60,
    "PageSize": 100,
    "MaxSettingLength": 1000
  },
  "Identity": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshReuseGraceSeconds": 10,
    "SigningKey": "",
    "DevLogin": false,
    "AdminPhones": "",
    "MaxNameLength": 64,
    "PowDifficultyBits": 14,
    "PowChallengeSeconds": 120,
    "SmsCodeDigits": 6,
    "SmsCodeSeconds": 120,
    "SmsCodeTries": 5,
    "SmsWaitSeconds": 60,
    "SmsPerPhonePerDay": 5,
    "SmsPerIpPerDay": 200,
    "SmsPerDay": 1000,
    "PasswordMinLength": 8,
    "PasswordMaxLength": 128,
    "PasswordMemoryKb": 19456,
    "PasswordIterations": 2,
    "PasswordHashConcurrency": 2,
    "PasswordTries": 5,
    "PasswordTriesPerIp": 100,
    "PasswordTriesWindowMinutes": 15
  },
  "Notification": {
    "SmsProvider": "",
    "Kavenegar": {
      "BaseUrl": "https://api.kavenegar.com",
      "ApiKey": "",
      "Template": "dalan-login",
      "TimeoutSeconds": 10
    },
    "Push": {
      "PublicKey": "",
      "PrivateKey": "",
      "Subject": "https://dalanet.ir",
      "AllowedHosts": "fcm.googleapis.com,push.apple.com,push.services.mozilla.com,notify.windows.com",
      "TtlSeconds": 86400,
      "MaxSubscriptionsPerUser": 10,
      "MaxEndpointLength": 1000,
      "MaxBodyLength": 200,
      "QueueSize": 10000,
      "Workers": 4,
      "TimeoutSeconds": 10
    }
  },
  "Relay": {
    "UpdateExpirySeconds": 60,
    "ExpirySweepSeconds": 5,
    "LatestCommandWins": true,
    "PollTimeoutDefaultSeconds": 30,
    "PollTimeoutMaxSeconds": 50,
    "MaxUpdatesPerPoll": 100,
    "MaxTextLength": 4096,
    "RateLimitWindowSeconds": 1,
    "BotRequestLimit": 30,
    "UserRequestLimit": 30,
    "MaxMessagesPerSync": 100,
    "MaxKeyboardButtons": 100,
    "MaxButtonTextLength": 64,
    "MaxStreamsPerUser": 5,
    "StreamHeartbeatSeconds": 20,
    "StreamBufferSize": 100,
    "OutboxPollSeconds": 5,
    "OutboxBatchSize": 100,
    "ClientReconnectMinSeconds": 1,
    "ClientReconnectMaxSeconds": 30,
    "MaxCaptionLength": 1024,
    "MaxCallbackDataBytes": 64,
    "MaxButtonUrlLength": 2048,
    "CallbackAnswerSeconds": 120,
    "MaxCallbackAnswerLength": 200,
    "MaxCommands": 100,
    "MaxCommandDescriptionLength": 256,
    "FileFolder": "files",
    "MaxFileSizeMb": 20,
    "FileRetentionDays": 30,
    "FileSweepMinutes": 60,
    "UserUploadMbPerDay": 200,
    "BotOnlineSeconds": 60,
    "ClientStatusRefreshSeconds": 30,
    "MaxBotsPerBuilder": 20,
    "MaxBotNameLength": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
