<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, whatever feeds the computer has (central package management turns two feeds into error NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
