# Front proxy. Domains come from the environment, never from this file.
#   DALAN_SITE_DOMAIN    for example dalanet.ir
#   DALAN_API_DOMAIN     for example api.dalanet.ir
#   DALAN_TUNNEL_DOMAIN  for example tunnel.dalanet.ir (the site agents connect here)
#   DALAN_UPSTREAM       Kestrel address, default 127.0.0.1:5000
#   DALAN_HTTP_PORT, DALAN_HTTPS_PORT   default 80 and 443 (tests use other ports)
{
	admin off
	http_port {$DALAN_HTTP_PORT:80}
	https_port {$DALAN_HTTPS_PORT:443}
	# OPS-15: a site host gets its certificate on its first visit, only when Dalan says it is a real site (SITE-17).
	on_demand_tls {
		ask http://{$DALAN_UPSTREAM:127.0.0.1:5000}/api/sites/tls
	}
}

# Every block passes the request to Dalan the same way.
(site) {
	# SEC-10: the server gets the client's real address and port, never what the client wrote in the header.
	# The server believes this header only from the proxies in Dalan:TrustedProxies.
	# A load balancer in front of this proxy changes both places: docs/ARCHITECTURE.md section 11.
	reverse_proxy {$DALAN_UPSTREAM:127.0.0.1:5000} {
		header_up X-Forwarded-For {remote}
	}
}

{$DALAN_SITE_DOMAIN}, {$DALAN_API_DOMAIN}, {$DALAN_TUNNEL_DOMAIN} {
	# OPS-06: probes are for the server itself only.
	@probes path /health /ready /api/sites/tls
	respond @probes 404
	import site
}

# OPS-15: every other HTTPS host is a user's site ("name.<sites domain>"). Its paths are the site's own, so none is blocked here.
https:// {
	tls {
		on_demand
	}
	import site
}

# OPS-18: "*.<sites domain>" with the wildcard certificate. deploy/wildcard-cert.sh writes wildcard.caddy next to this
# file after the first certificate. Before that no file matches, which Caddy accepts, and each site gets its own (OPS-15).
import wildcard*.caddy
