# systemd unit for the Dalan server. Install to /etc/systemd/system/dalan.service.
[Unit]
Description=Dalan relay server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dalan
Group=dalan
WorkingDirectory=/opt/dalan/current
ExecStart=/opt/dalan/current/Dalan.Host
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# Files sent in chats. systemd makes /var/lib/dalan, owned by the dalan user.
StateDirectory=dalan
Environment=Relay__FileFolder=/var/lib/dalan/files
# Secrets live only on the server, never in the repository.
# Must hold the database: ConnectionStrings__Dalan=Host=localhost;Database=dalan;Username=dalan;Password=...
# Must hold the key that signs sessions (without it every restart logs all users out): Identity__SigningKey=<key>
#   Make one with: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -outform DER | base64 -w0
# Must hold the SMS provider, or nobody can log in by SMS:
#   Notification__SmsProvider=kavenegar
#   Notification__Kavenegar__ApiKey=<key>
#   (the OTP template in the Kavenegar panel is named by Notification:Kavenegar:Template, start "dalan-login")
# Push notifications (off without them). Make the pair once with: node scripts/vapid-keys.mjs
#   Notification__Push__PublicKey=<key>
#   Notification__Push__PrivateKey=<key>
# If a proxy or load balancer other than Caddy on this machine is in front, it must hold (else every client is recorded with
# the proxy's address): Dalan__TrustedProxies=127.0.0.1,::1,<address or CIDR range>
EnvironmentFile=/etc/dalan/dalan.env
# Written by deploy.sh: Dalan__Version=<git commit>
EnvironmentFile=-/opt/dalan/current/version.env
Restart=on-failure
RestartSec=5
# Must be longer than Dalan:ShutdownTimeoutSeconds.
TimeoutStopSec=40

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
